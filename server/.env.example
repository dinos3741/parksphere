# Copy this file to .env and fill in real values. .env is gitignored; this file is not — it should
# never contain anything but placeholders.

# Google OAuth client IDs (web + iOS) — from Google Cloud Console, used to verify Google id_tokens.
GOOGLE_CLIENT_ID=
GOOGLE_MOBILE_CLIENT_ID=

# Signs every locally-issued JWT. Required — the server refuses to start without it. Generate one
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3001

# Postgres connection. DB_PASSWORD is required — the server refuses to start without it. The other
# fields default to this project's local dev values (see db.js) if left unset.
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=

# Keycloak connection + admin API credentials (used for user provisioning, password resets,
# federated identity linking). KEYCLOAK_ADMIN_PASSWORD is required — the server refuses to start
# without it. KEYCLOAK_BASE_URL/KEYCLOAK_REALM default to this project's local dev values if unset.
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
