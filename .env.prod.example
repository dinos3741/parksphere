# Copy to .env.prod and fill in real values. .env.prod is gitignored; this file is not — it should
# never contain anything but placeholders.
#
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# The public domain this deploys to (DNS A record must already point at this host's IP before
# starting Caddy, or the automatic HTTPS certificate request will fail). No scheme, no path.
DOMAIN=

# Keycloak's own Postgres.
KEYCLOAK_DB_PASSWORD=

# Keycloak bootstrap admin account (console reachable only via SSH tunnel — see
# docker-compose.prod.yml's top comment).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# The realm the server authenticates against — must match a realm you've created in the Keycloak
# admin console after first boot (realm creation itself isn't automated here; see the deployment
# notes for the manual one-time setup this needs).
KEYCLOAK_REALM=

# The app's own Postgres (separate from Keycloak's — same architecture as local dev).
APP_DB_NAME=parksphere_db
APP_DB_USER=parksphere
APP_DB_PASSWORD=

# Signs every locally-issued JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth client IDs (web + iOS) — from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_MOBILE_CLIENT_ID=
